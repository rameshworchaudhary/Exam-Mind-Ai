// firestore.rules
// Deploy with: firebase deploy --only firestore:rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users can only read/write their own profile
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Daily Usage - user can read their own quota, only server (Admin SDK) can write/update/delete
    match /dailyUsage/{usageId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Uploads - users can only access their own
    match /uploads/{uploadId} {
      allow get, list, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Notes
    match /notes/{noteId} {
      allow get, list, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow get, list, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Chat history
    match /chatHistory/{chatId} {
      allow get, list, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Study plans
    match /studyPlans/{planId} {
      allow get, list, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Predictions
    match /predictions/{predId} {
      allow get, list, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Subscriptions - users can only read/write their own
    match /subscriptions/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Payment logs - read only for user
    match /paymentLogs/{logId} {
      allow get, list, update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }
  }
}

